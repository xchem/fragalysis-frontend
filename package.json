  "description": "Frontend for fragalysis",
  "main": "webpack.config.js",
  "scripts": {
    "start": "node ./server.js",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "testwatch": "jest --watchAll",
    "build": "webpack --config webpack.config.js --progress --mode production && yarn test:webpack-stats",
    "watch": "webpack --config webpack.config.js --watch",
    "dev": "webpack --config webpack.config.js --mode development --watch",
    "test:webpack-stats": "node scripts/validate-webpack-stats.js",
    "cy:install": "cypress install",
    "cy:run": "cypress run --e2e --browser chrome",
    "cy:smoke": "cypress run --e2e --browser chrome --spec cypress/e2e/smoke.cy.js",
    "runner": "cypress open --e2e --browser chrome"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/setupTests.js",
      "jest-canvas-mock"
    ],
    "testEnvironment": "jsdom"
  },
